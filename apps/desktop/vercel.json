{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "User-Agent",
          "value": ".*(Mobile|Android|iPhone|iPad).*"
        }
      ],
      "permanent": false,
      "destination": "https://carveri-portal-mobile-dev.vercel.app/"
    }
  ]
}
